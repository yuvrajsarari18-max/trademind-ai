# ============================================
#  TradeMind AI — Environment Configuration
# ============================================

# --- LLM Model (swap karo koi bhi) ---
LLM_MODEL=gemini/gemini-2.0-flash        # Default (free)
# LLM_MODEL=gpt-4o                       # OpenAI
# LLM_MODEL=claude-3-5-sonnet-20241022   # Anthropic
# LLM_MODEL=ollama/llama3                # Local (free forever)

# --- API Keys ---
GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_key_here
# ANTHROPIC_API_KEY=your_key_here

# --- Market Data ---
NEWS_API_KEY=your_newsapi_key_here       # newsapi.org (free)

# --- Crypto Exchange (optional, for live trading) ---
EXCHANGE=binance
EXCHANGE_API_KEY=                        # Leave blank for read-only
EXCHANGE_SECRET=

# --- Agent Settings ---
MAX_REASONING_STEPS=15                   # ReAct loop max steps
MAX_REFLEXION_ITERATIONS=3              # Self-fix loop max
CONFIDENCE_THRESHOLD=0.70               # Min confidence for signal

# --- Markets to Watch ---
CRYPTO_SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT
STOCK_SYMBOLS=RELIANCE.NS,TCS.NS,NIFTY50=F.NS
